{
  "apps": [
    {
      "name": "app",
      "script": "build/src/index.js",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "time": true,
      "kill_timeout": 15000,
      "env": {
        "NODE_ENV": "production",
        "QUEUE_WORKERS": "false"
      }
    },
    {
      "name": "worker",
      "script": "build/src/worker.js",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "time": true,
      "kill_timeout": 15000,
      "exp_backoff_restart_delay": 2000,
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
